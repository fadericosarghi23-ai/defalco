---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ProcessCards from '../components/ProcessCards.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Cta from '../components/Cta.astro';
import { site, abs } from '../data/site';
import { servizi } from '../data/servizi';
import { team } from '../data/team';
import { progetti, progetto } from '../data/progetti';
import { heroSlides, progettiHome, numeriHome, aree, faq, FAQ_COL1 } from '../data/contenuti';

const title = 'Studio Tecnico De Falco | Geometra a Mortara (PV)';
const description = site.descrizione;
const fotoStudio = progetto('ampliamento-capannone-cilavegna').immagini[0];
const faqLd = {
  '@type': 'FAQPage',
  '@id': abs('/#faq'),
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.d, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
};
---
<Layout title={title} description={description} transparent ld={[faqLd]}>
<section class="hero" aria-label="Progetti in evidenza"> <div class="hero-slides" data-hero> {heroSlides.map((s, i) => <figure class:list={['hero-slide', { 'is-active': i === 0 }]} data-title={s.titolo} data-location={s.luogo} data-href={s.href}> <Picture img={s.img} eager={i === 0} class="full-img" /> </figure>)} </div> <div class="container hero-content"> <p class="eyebrow-light mb-3">{site.nome} · {site.attivita} · {site.indirizzo.citta}</p> <h1 class="h1">Il geometra di Mortara, <em>dal rilievo al cantiere</em></h1> <div class="hero-meta"> <div> <p class="lead">Progetti e ristrutturazioni, pratiche edilizie, catasto, rilievi e sicurezza: lo studio del geom. Giovanni De Falco segue case, terreni e cantieri della Lomellina con un unico referente dall’inizio alla fine.</p> <div class="btn-row"> <a href="/progetti/" class="btn btn-primary">Guarda i progetti</a> <a href="/contatti/#richiesta" class="btn btn-outline-light">Richiedi un preventivo</a> </div> </div> <div class="hero-caption" aria-live="polite"> <span class="label">Nella foto</span> <a href={heroSlides[0].href} class="link-underline" data-hero-caption>{heroSlides[0].titolo} · {heroSlides[0].luogo}</a> <div class="hero-dots" role="group" aria-label="Scegli immagine"> {heroSlides.map((s, i) => <button type="button" aria-label={`Mostra ${s.titolo}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>)} </div> </div> </div> </div> </section>

<section class="section"> <div class="container split"> <div class="reveal"> <div class="ratio-45"> <Picture img={fotoStudio} sizes="(min-width: 1024px) 38vw, 92vw" /> </div> </div> <div class="reveal"> <p class="eyebrow mb-2">Lo studio</p> <h2 class="h2">Un solo tecnico per progetto, carte e cantiere</h2> <div class="prose mt-3 lead"> <p><strong>Lo Studio Tecnico De Falco</strong> è lo studio del geometra Giovanni De Falco in Via Cesare Bressa a Mortara. Si occupa di edilizia, catasto e topografia: dalla piccola pratica alla ristrutturazione completa.</p> <p>Lavora per famiglie, aziende agricole, imprese e amministratori di condominio della Lomellina. Ogni incarico è seguito di persona, dal primo sopralluogo all’aggiornamento catastale finale, con tempi e costi chiari.</p> </div> <div class="stats mt-4"> {numeriHome.map((s) => <div class="stat"><strong>{s.n}</strong><span>{s.label}</span></div>)} </div> <a href="/studio/" class="btn btn-outline mt-4">Conosci lo studio</a> </div> </div> </section>

<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">Servizi</p> <h2 class="h2">Tutto quello che serve a casa e terreni</h2> <p class="lead mt-2">Sei servizi tecnici coordinati dallo stesso studio, dal progetto al catasto.</p> </div> <a href="/servizi/" class="btn btn-outline">Scopri tutti i servizi</a> </div> <ul class="services services-3 reveal"> {servizi.map((s) => <li class="service"> <Icon name={s.icona} class="icon" /> <h3 class="h4"><a href={`/servizi/#${s.id}`} class="link-underline">{s.nome}</a></h3> <p>{s.breve}</p> </li>)} </ul> </div> </section>

<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Metodo</p> <h2 class="h2">Come lavoriamo</h2> </div> <a href="/metodo/" class="text-link link-underline">Il metodo completo</a> </div> <ProcessCards /> </div> </section>

<section class="section" style="padding-top: 0"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Progetti</p> <h2 class="h2">Da una casa a corte a un fondo agricolo</h2> </div> <a href="/progetti/" class="text-link link-underline">Tutti i {progetti.length} progetti</a> </div> <div class="projects-grid"> {progettiHome.map((slug) => <ProjectCard p={progetto(slug)} />)} </div> </div> </section>

<section class="section bg-ink"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Dove lavoriamo</p> <h2 class="h2">Da Mortara a tutta la Lomellina, e oltre</h2> <p class="lead mt-2" style="color: rgb(255 255 255 / 0.72)">Lo studio ha sede a Mortara e lavora per privati, aziende e condomini in tutta la Lomellina, nel Pavese e nel Novarese.</p> </div> </div> <ul class="areas reveal"> {aree.map((a) => <li class="area"> <span>{a.conteggio}</span> <strong>{a.nome}</strong> <p>{a.comuni}</p> </li>)} </ul> </div> </section>

{/* striscia team: solo con almeno 3 persone (studio con un solo titolare → si vede nella pagina Studio) */}
{team.length >= 3 && (
<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Il team</p> <h2 class="h2">Il geometra dello studio</h2> <p class="lead mt-2">Un referente unico che segue ogni lavoro di persona.</p> </div> <a href="/studio/#team" class="text-link link-underline">Conosci il team</a> </div> <div class="team-strip reveal"> {team.slice(0, 7).map((m) => <a href={`/studio/#${m.id}`} title={`${m.nome}, ${m.ruolo}`}> <Picture img={m.foto} sizes="(min-width: 768px) 14vw, 33vw" /> </a>)} </div> </div> </section>
)}

<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">FAQ</p> <h2 class="h2">Domande frequenti</h2> <p class="lead mt-2">Non trovi la risposta che cerchi? Scrivici o chiamaci.</p> </div> <a href="/contatti/" class="btn btn-outline">Contattaci</a> </div> <div class="faq-cols reveal"> {[faq.slice(0, FAQ_COL1), faq.slice(FAQ_COL1)].map((col, c) => <div class="faq"> {col.map((f, i) => <details open={c === 0 && i === 0}> <summary>{f.d}</summary> <p>{f.r}</p> </details>)} </div>)} </div> </div> </section>

<section class="section"> <div class="container grid-2"> <div class="reveal"> <p class="eyebrow mb-2">Dove siamo</p> <h2 class="h2">{site.nome} a {site.indirizzo.citta}</h2> <p class="lead mt-3">Lo studio si trova in Via Cesare Bressa 11, in centro a Mortara. Riceviamo su appuntamento.</p> <div class="contact-cards mt-4"> <div class="contact-card"> <h3>Indirizzo</h3> <p>{site.indirizzo.via}<br>{site.indirizzo.cap} {site.indirizzo.citta} ({site.indirizzo.provincia})</p> <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline mt-1" style="display:inline-block">Apri in Google Maps</a> </div> <div class="contact-card"> <h3>Contatti</h3> <p><a href={`tel:${site.telefonoE164}`}>{site.telefono}</a></p> {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>} </div> </div> </div> <div class="map reveal"> <MapEmbed span={0.012} /> </div> </div> </section>
<Cta />
<script>
var e=document.querySelector(`[data-hero]`);if(e){let t=[...e.querySelectorAll(`.hero-slide`)],n=[...document.querySelectorAll(`[data-dot]`)],r=document.querySelector(`[data-hero-caption]`),i=window.matchMedia(`(prefers-reduced-motion: reduce)`).matches,a=0,o,s=e=>{t[a].classList.remove(`is-active`),n[a].setAttribute(`aria-current`,`false`),a=(e+t.length)%t.length;let i=t[a];i.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)),i.classList.add(`is-active`),n[a].setAttribute(`aria-current`,`true`),r&&(r.textContent=`${i.dataset.title} · ${i.dataset.location}`,r.href=i.dataset.href||`#`)},c=()=>{i||(o=window.setInterval(()=>s(a+1),6e3))};n.forEach((e,t)=>e.addEventListener(`click`,()=>{window.clearInterval(o),s(t),c()})),window.addEventListener(`load`,()=>t.forEach(e=>e.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)))),c()}
</script>
</Layout>
